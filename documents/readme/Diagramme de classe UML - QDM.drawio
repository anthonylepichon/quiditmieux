        <mxCell id="p5_note" value="&lt;b&gt;Transaction lors du suivi&lt;/b&gt;&lt;br&gt;Le contrôleur démarre une transaction, vérifie les règles avec ListingModel, modifie ASSOC_UTILISATEUR_ANNONCE avec FollowModel, puis valide. En cas d&#39;échec, il annule la transaction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B21B6;fontColor=#18103A;fontSize=13;align=left;verticalAlign=middle;spacing=10;arcSize=10;dashed=1;" parent="p5_layer" vertex="1">
          <mxGeometry x="60" y="1180" width="1100" height="82" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
